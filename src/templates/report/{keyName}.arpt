// Reporte AlphaReport Engine: {keyNamePascal}
//
// Estructura de un .arpt:
//   exports.metadata    → objeto o función async (parámetros del formulario)
//   exports.generatePDF → opcional, react-pdf (declarativo, OK <500 filas)
//   exports.generatePdfKit → opcional, pdfkit (imperativo, 60x más rápido)
//   exports.generateExcel  → opcional, exceljs
//
// Si exportas `generatePdfKit`, el engine lo prefiere sobre `generatePDF`
// automáticamente. Para datasets grandes (>500 filas) usa pdfkit.
//
// Hot-reload: el engine recarga el .arpt al guardar; no necesitas restart.

const React = require("react");
const {
  Document,
  Page,
  Text,
  View,
  StyleSheet,
} = require("@react-pdf/renderer");

// ─── 1. METADATA ─────────────────────────────────────────────────────────────
// Puede ser un objeto plano O una función async que recibe `ctx` para cargar
// opciones desde la DB (ej. lista dinámica de almacenes).
exports.metadata = {
  name: "{keyNamePascal}",
  description: "{description}",
  parameters: [
    {
      name: "Titulo",
      type: "text",
      label: "Título del reporte",
      default: "{keyNamePascal}",
      required: true,
      minLength: 1,
      maxLength: 80,
    },
    {
      name: "FechaInicio",
      type: "date",
      label: "Desde",
      default: "",
      required: true,
    },
    {
      name: "FechaFin",
      type: "date",
      label: "Hasta",
      default: "",
      required: true,
      validate: (value, allValues) => {
        if (allValues.FechaInicio && value && value < allValues.FechaInicio) {
          return "Debe ser posterior a la fecha inicio";
        }
        return null;
      },
    },
    {
      name: "IncluirInactivos",
      type: "checkbox",
      label: "Incluir registros inactivos",
      default: false,
    },
  ],
};

