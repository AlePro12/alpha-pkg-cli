// ─── 2. HELPERS COMPARTIDOS ──────────────────────────────────────────────────
// Mejor práctica: extraer la query a un helper que las dos funciones (PDF y
// Excel) puedan reusar. Evita duplicación y desincronización.

async function loadData(ctx) {
  const { params, models, empresaId } = ctx;
  // TODO: reemplaza por tu colección real, p.ej.:
  //   return await models.Facturas.find({
  //     empresa: empresaId,
  //     Fecha: { $gte: new Date(params.FechaInicio), $lte: new Date(params.FechaFin) },
  //     ...(params.IncluirInactivos ? {} : { Activo: true }),
  //   }).limit(2000).lean();
  return [
    { Codp: "P0001", Descripcion: "Producto demo 1", Cantidad: 12, Total: 145.5 },
    { Codp: "P0002", Descripcion: "Producto demo 2", Cantidad: 7, Total: 98.0 },
  ];
}

const fmtDate = (d) => (d ? new Date(d).toLocaleDateString("es-VE") : "");
const fmtNum = (n) => (typeof n === "number" ? n.toFixed(2) : "");

// ─── 3. PDF — react-pdf (declarativo) ────────────────────────────────────────
const styles = StyleSheet.create({
  page: { padding: 30, fontSize: 10, fontFamily: "Helvetica" },
  header: { fontSize: 14, fontWeight: "bold", marginBottom: 4 },
  subheader: { fontSize: 9, color: "#555", marginBottom: 12 },
  table: { marginTop: 8, borderTop: "1px solid #999", borderLeft: "1px solid #999" },
  row: { flexDirection: "row", borderBottom: "1px solid #ccc" },
  headerRow: { backgroundColor: "#eee", fontWeight: "bold" },
  cell: { padding: 4, borderRight: "1px solid #ccc" },
});

exports.generatePDF = async function (ctx) {
  const { params, getEmpresaInfo } = ctx;
  const empresa = await getEmpresaInfo();
  const rows = await loadData(ctx);

  return (
    <Document>
      <Page size="LETTER" style={styles.page}>
        <Text style={styles.header}>
          {empresa?.nombre} — {params.Titulo}
        </Text>
        <Text style={styles.subheader}>
          {fmtDate(params.FechaInicio)} — {fmtDate(params.FechaFin)}
          {empresa?.rif ? `   ·   ${empresa.rif}` : ""}
        </Text>

        <View style={styles.table}>
          <View style={[styles.row, styles.headerRow]}>
            <Text style={[styles.cell, { width: "15%" }]}>Código</Text>
            <Text style={[styles.cell, { width: "55%" }]}>Descripción</Text>
            <Text style={[styles.cell, { width: "15%", textAlign: "right" }]}>Cantidad</Text>
            <Text style={[styles.cell, { width: "15%", textAlign: "right" }]}>Total</Text>
          </View>
          {rows.map((r, i) => (
            <View key={i} style={styles.row}>
              <Text style={[styles.cell, { width: "15%" }]}>{r.Codp}</Text>
              <Text style={[styles.cell, { width: "55%" }]}>{r.Descripcion}</Text>
              <Text style={[styles.cell, { width: "15%", textAlign: "right" }]}>{r.Cantidad}</Text>
              <Text style={[styles.cell, { width: "15%", textAlign: "right" }]}>{fmtNum(r.Total)}</Text>
            </View>
          ))}
        </View>
      </Page>
    </Document>
  );
};

// ─── 4. EXCEL — exceljs ──────────────────────────────────────────────────────
exports.generateExcel = async function (ctx) {
  const ExcelJS = require("exceljs");
  const { params, getEmpresaInfo } = ctx;
  const empresa = await getEmpresaInfo();
  const rows = await loadData(ctx);

  const wb = new ExcelJS.Workbook();
  const ws = wb.addWorksheet("{keyNamePascal}");

  ws.addRow([empresa?.nombre || ""]);
  ws.addRow([params.Titulo]);
  ws.addRow([`${fmtDate(params.FechaInicio)} — ${fmtDate(params.FechaFin)}`]);
  ws.addRow([]);

  ws.addRow(["Código", "Descripción", "Cantidad", "Total"]);
  rows.forEach((r) => ws.addRow([r.Codp, r.Descripcion, r.Cantidad, r.Total]));

  ws.getRow(5).font = { bold: true };
  ws.columns = [{ width: 14 }, { width: 40 }, { width: 12 }, { width: 14 }];
  ws.getColumn(3).numFmt = "#,##0";
  ws.getColumn(4).numFmt = "#,##0.00";

  return await wb.xlsx.writeBuffer();
};

